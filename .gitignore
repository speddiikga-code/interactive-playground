node_modules/
dist/
build/
.venv/
__pycache__/
*.pyc

# Secrets — never commit. preflight.sh also greps for key shapes.
.env
.env.*
!.env.example
*.pem
id_rsa*

# Claude Code local state (settings.json IS committed; local overrides are not)
.claude/settings.local.json

.DS_Store

# Personal contact data — NEVER commit.
# Korea's 개인정보보호법 (PIPA) governs personal information; a git repo is the
# wrong container for it (repos get forked, pushed and made public by accident).
pipeline/contacts.local.json
pipeline/*.local.json
